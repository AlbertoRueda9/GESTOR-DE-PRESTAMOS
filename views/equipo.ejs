<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= equipo.codigo %> · Préstamos de material</title>
</head>
<body>
<header>
  <h1><%= equipo.nombre %></h1>
  <p><a href="/equipos">« Volver al listado</a></p>
</header>
<main>
  <section>
    <h2>Datos del equipo</h2>
    <dl>
      <dt>Código</dt><dd><%= equipo.codigo %></dd>
      <dt>Categoría</dt><dd><%= equipo.categoria %></dd>
      <dt>Estado</dt><dd><%= equipo.disponible ? 'Disponible' : 'Prestado' %></dd>
      <% if (equipo.prestamoActivo) { %>
        <dt>Prestado a</dt>
        <dd><%= equipo.prestamoActivo.usuario.nombre %> desde el <%= equipo.prestamoActivo.fechaTexto %>
            (préstamo n.º <%= equipo.prestamoActivo.id %>)</dd>
      <% } %>
    </dl>
  </section>

  <section>
    <h2>Historial de préstamos</h2>
    <% if (historial.length === 0) { %>
      <p>Este equipo no tiene préstamos registrados.</p>
    <% } else { %>
      <table>
        <thead>
          <tr><th scope="col">N.º</th><th scope="col">Usuario</th><th scope="col">Prestado</th><th scope="col">Devuelto</th></tr>
        </thead>
        <tbody>
          <% for (const p of historial) { %>
            <tr>
              <td><%= p.id %></td>
              <td><%= p.usuario %></td>
              <td><%= p.prestado %></td>
              <td><%= p.devuelto ?? 'Activo (sin devolver)' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  </section>
</main>
</body>
</html>
